# Local Zotero Debug Bridge. Required for local read/write commands.
ZOTERO_DEBUG_BRIDGE_TOKEN=

# Optional. Defaults to the standard local Debug Bridge endpoint.
ZOTERO_DEBUG_BRIDGE_URL=http://127.0.0.1:23119/debug-bridge/execute

# Optional. Personal library is usually 1.
ZOTERO_LIBRARY_ID=1

# Optional. Required only for Zotero Web API commands.
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_GROUP_ID=

# Optional. Used for polite CrossRef/Unpaywall requests.
CROSSREF_EMAIL=
