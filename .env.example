# Official Zotero 10+ Local API. No manually configured key is normally required.
ZOTERO_LOCAL_API_URL=http://127.0.0.1:23119/api
ZOTERO_LOCAL_LIBRARY_PREFIX=/users/0

# Optional overrides.
ZOTERO_LOCAL_API_APP_NAME=Zotero MCP
# ZOTERO_MCP_CREDENTIALS_FILE=
# ZOTERO_LOCAL_API_KEY=

# Optional real contact email. Enables Unpaywall PDF resolution and is used for
# polite CrossRef requests.
CROSSREF_EMAIL=
