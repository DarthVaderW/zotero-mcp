{
  "mcpServers": {
    "zotero": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/DarthVaderW/zotero-mcp.git@stable",
        "zotero-mcp"
      ],
      "env_vars": [
        "ZOTERO_LOCAL_API_URL",
        "ZOTERO_LOCAL_LIBRARY_PREFIX",
        "ZOTERO_LOCAL_API_APP_NAME",
        "ZOTERO_MCP_CREDENTIALS_FILE",
        "ZOTERO_LOCAL_API_KEY",
        "CROSSREF_EMAIL"
      ]
    }
  }
}
