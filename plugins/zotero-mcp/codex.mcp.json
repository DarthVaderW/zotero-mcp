{
  "mcpServers": {
    "zotero": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/DarthVaderW/zotero-mcp.git@v0.1.5",
        "zotero-mcp"
      ],
      "env_vars": [
        "ZOTERO_DEBUG_BRIDGE_TOKEN",
        "ZOTERO_DEBUG_BRIDGE_URL",
        "ZOTERO_LIBRARY_ID",
        "ZOTERO_API_KEY",
        "ZOTERO_USER_ID",
        "ZOTERO_GROUP_ID",
        "CROSSREF_EMAIL"
      ]
    }
  }
}
