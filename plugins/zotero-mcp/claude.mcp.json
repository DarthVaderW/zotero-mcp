{
  "mcpServers": {
    "zotero": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/DarthVaderW/zotero-mcp.git@stable",
        "zotero-mcp"
      ],
      "env": {
        "ZOTERO_BACKEND": "${user_config.zotero_backend}",
        "ZOTERO_LOCAL_API_URL": "${user_config.zotero_local_api_url}",
        "ZOTERO_LOCAL_LIBRARY_PREFIX": "${user_config.zotero_local_library_prefix}",
        "ZOTERO_API_KEY": "${user_config.zotero_api_key}",
        "ZOTERO_USER_ID": "${user_config.zotero_user_id}",
        "ZOTERO_GROUP_ID": "${user_config.zotero_group_id}",
        "CROSSREF_EMAIL": "${user_config.crossref_email}"
      }
    }
  }
}
